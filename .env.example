# Public application configuration
NEXT_PUBLIC_APP_URL=https://tikse-tech.vercel.app

# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# If your project uses the newer publishable naming, set this as an alternative fallback.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side configuration (never expose this to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Local dev/test only. Must remain false in production.
USE_LOCAL_STORE=false

# Optional email integration
EMAIL_API_KEY=
EMAIL_FROM=
