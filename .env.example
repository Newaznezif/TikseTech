# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# If your project uses the newer publishable naming, set this as an alternative fallback.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase server-side configuration (never expose this to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Local demo mode. Set to false in production when Supabase is ready.
USE_LOCAL_STORE=true

# Optional email integration
EMAIL_API_KEY=
EMAIL_FROM=
