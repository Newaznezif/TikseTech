# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative for projects using the newer publishable key format:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never expose or commit this key.
SUPABASE_SERVICE_ROLE_KEY=

# Local development only. Never enable local JSON storage in production.
USE_LOCAL_STORE=false
SESSION_SECRET=replace-with-a-long-random-secret

# Optional transactional email provider (for example, Resend)
RESEND_API_KEY=
EMAIL_FROM=
